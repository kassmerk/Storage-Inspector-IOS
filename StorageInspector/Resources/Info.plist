<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The only way a sandboxed app may ask iOS "is this app installed?": canOpenURL on a scheme
	  the other app registers. iOS answers nothing for a scheme that is not listed here, and the
	  list is capped at 50 entries per app — AppSchemeProbe.candidates carries the same 50 apps
	  (name, bundle id, developer, scheme) and must be kept in sync with this array.

	  Everything else in Info.plist is still generated from the build settings in
	  project.pbxproj (GENERATE_INFOPLIST_FILE = YES); this file only adds the key Xcode has no
	  setting for.
	-->
